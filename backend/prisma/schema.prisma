generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mode-level progress (max unlocked level per user + mode).
model ModeProgress {
  id                 Int      @id @default(autoincrement())
  portal_user_id     Int
  username           String
  game_mode          String
  max_unlocked_level Int      @default(1)
  updated_at         DateTime @updatedAt
  created_at         DateTime @default(now())

  @@unique([portal_user_id, game_mode])
  @@index([portal_user_id])
  @@index([game_mode])
  @@map("mode_progress")
}

// Per-attempt level records (stars/time/moves).
model LevelRecord {
  id             Int      @id @default(autoincrement())
  portal_user_id Int
  username       String
  level          Int
  moves_count    Int
  time_seconds   Int
  stars          Int      @default(1)
  game_mode      String   @default("classic")
  completed_at   DateTime @default(now())

  @@index([portal_user_id])
  @@index([portal_user_id, game_mode])
  @@index([portal_user_id, game_mode, level])
  @@map("level_records")
}

// Persistent hint inventory by user.
model UserHint {
  id             Int      @id @default(autoincrement())
  portal_user_id Int      @unique
  username       String
  hint_count     Int      @default(1)
  updated_at     DateTime @updatedAt
  created_at     DateTime @default(now())

  @@index([portal_user_id])
  @@map("user_hints")
}
