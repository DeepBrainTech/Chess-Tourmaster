# 开发环境配置
NODE_ENV=development

# 数据库连接（Docker 开发环境）
DATABASE_URL="postgresql://chess_user:dev_password_123@localhost:5433/chess_tourmaster_dev?schema=public"

# JWT 密钥（开发环境，不要在生产使用）
JWT_SECRET="dev-jwt-secret-for-testing-only"
TOURMASTER_JWT_SECRET="dev-tourmaster-secret-for-testing-only"

# Next.js 配置
NEXT_TELEMETRY_DISABLED=1

# 热重载配置（Docker 中需要）
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true
