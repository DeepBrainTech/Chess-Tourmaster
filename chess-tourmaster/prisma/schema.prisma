generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Mode-level progress (max unlocked level per user + mode).
model ModeProgress {
  id                 Int      @id @default(autoincrement())
  portal_user_id     Int
  username           String
  game_mode          String
  max_unlocked_level Int      @default(1)
  updated_at         DateTime @updatedAt
  created_at         DateTime @default(now())

  @@unique([portal_user_id, game_mode])
  @@index([portal_user_id])
  @@index([game_mode])
  @@map("mode_progress")
}

// Historical clears recorded before per-level bests were introduced.
model LevelRecord {
  id             Int      @id @default(autoincrement())
  portal_user_id Int
  username       String
  level          Int
  moves_count    Int
  time_seconds   Int
  stars          Int      @default(1)
  game_mode      String   @default("classic")
  completed_at   DateTime @default(now())

  @@index([portal_user_id])
  @@index([portal_user_id, game_mode])
  @@index([portal_user_id, game_mode, level])
  @@map("level_records")
}

model LevelBest {
  portal_user_id    Int
  game_mode         String
  level             Int
  best_stars        Int
  best_time_seconds Int
  best_moves        Int
  first_cleared_at  DateTime
  clear_count       Int      @default(1)

  @@id([portal_user_id, game_mode, level])
  @@map("level_bests")
}

// Persistent hint inventory by user.
model UserHint {
  id             Int      @id @default(autoincrement())
  portal_user_id Int      @unique
  username       String
  hint_count     Int      @default(1)
  undo_count     Int      @default(1)
  updated_at     DateTime @updatedAt
  created_at     DateTime @default(now())

  @@index([portal_user_id])
  @@map("user_hints")
}


// Delivery receipts provide idempotency; usable stock remains in user_hints.
model InventoryDelivery {
  portal_user_id Int
  purchase_id    String   @db.Uuid
  hint_count     Int      @default(0)
  undo_count     Int      @default(0)
  created_at     DateTime @default(now())

  @@id([portal_user_id, purchase_id])
  @@map("inventory_deliveries")
}

model GameAttempt {
  id             String    @id @default(uuid()) @db.Uuid
  portal_user_id Int
  game_mode      String
  level          Int
  level_version  Int
  started_at     DateTime  @default(now())
  resumed_at     DateTime?
  active_ms      Int       @default(0)
  finished_at    DateTime?
  stars          Int?
  moves_count    Int?
  summarized     Boolean   @default(false)
  hints          AttemptHint[]
  achievement_notification AchievementNotification?

  @@index([portal_user_id])
  @@map("game_attempts")
}

model AchievementNotification {
  attempt_id      String      @id @db.Uuid
  portal_user_id  Int
  game_mode       String
  clears          Int
  three_stars     Int
  new_clear       Boolean
  new_three_stars Boolean
  next_attempt_at DateTime    @default(now())
  attempt         GameAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)

  @@index([next_attempt_at])
  @@map("achievement_notifications")
}

model AttemptHint {
  attempt_id   String @db.Uuid
  position_key String
  move_r       Int
  move_c       Int
  attempt      GameAttempt @relation(fields: [attempt_id], references: [id], onDelete: Cascade)

  @@id([attempt_id, position_key])
  @@map("attempt_hints")
}
