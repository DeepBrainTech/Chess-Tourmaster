DATABASE_URL=postgresql://user:password@localhost:5432/chess_tourmaster
TOURMASTER_JWT_SECRET=replace_with_real_secret
TOURMASTER_JWT_ALG=HS256
TOURMASTER_JWT_AUD=chess-tourmaster
TOURMASTER_JWT_ISS=main-portal
# Optional separate signing key for the game's HttpOnly session (24 hours).
# TOURMASTER_SESSION_JWT_SECRET=replace_with_separate_session_secret
# Browser-facing portal addresses. Set localhost:8000 / localhost:3000 for local integration.
NEXT_PUBLIC_PORTAL_API_BASE=https://api.deepbraintechnology.com
NEXT_PUBLIC_PORTAL_URL=https://deepbraintechnology.com
# Only set this when frontend and backend are deployed on different domains.
NEXT_PUBLIC_API_URL=
# Comma-separated exact origins; unset/empty disables cross-origin access.
CORS_ORIGINS=https://chess-tourmaster.pages.dev,https://chess-tourmaster.deepbraintechnology.com,https://knightours-chess.deepbraintechnology.com
# Optional: jti 并发幂等窗口（秒），默认 30，合法范围 5～60
# TOURMASTER_EXCHANGE_REPLAY_WINDOW_SECONDS=30
# Optional: 写入 jti 并与 internal redeem 对齐的 game_mode；默认等于 TOURMASTER_JWT_AUD
# TOURMASTER_EXCHANGE_GAME_MODE=chess-tourmaster
