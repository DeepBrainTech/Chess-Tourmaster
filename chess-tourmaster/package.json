{
  "name": "chess-tourmaster",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint app components hooks lib --max-warnings 0",
    "db:init": "prisma generate && npm run db:push",
    "db:push": "prisma db push && node prisma/backfill-level-bests.cjs",
    "db:generate": "prisma generate",
    "db:deploy": "npm run db:push",
    "test:commerce": "node --test tests/*.test.cjs",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.0"
  }
}
